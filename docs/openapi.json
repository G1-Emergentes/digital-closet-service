{
  "openapi": "3.0.3",
  "info": {
    "title": "Mirage Digital Closet Service",
    "version": "1.0.0",
    "description": "API C++17/Drogon del armario digital: prendas, imágenes privadas y outfits guardados. Usa el access_token de IAM (login en el servicio IAM, puerto 8080) en Authorize. Los ejemplos son ficticios; Try it out modifica el proyecto Supabase configurado. Contrato con Recommendation: GET /garments, POST /garments/resolve y GET /garments/{id}/image-access."
  },
  "servers": [
    {
      "url": "/",
      "description": "Este servidor"
    }
  ],
  "tags": [
    {
      "name": "Garments"
    },
    {
      "name": "Outfits"
    },
    {
      "name": "Health"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Comprobar que el servicio responde",
        "operationId": "health",
        "security": [],
        "responses": {
          "200": {
            "description": "Servicio activo.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string",
                  "example": "ok"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/garments": {
      "get": {
        "tags": [
          "Garments"
        ],
        "summary": "Listar las prendas propias",
        "operationId": "listGarments",
        "description": "Contrato con Recommendation (§5). Orden estable por id. next_cursor null indica el final.",
        "parameters": [
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/Cursor"
          }
        ],
        "responses": {
          "200": {
            "description": "Página de prendas (disponibles y no disponibles; no incluye eliminadas).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GarmentPage"
                }
              }
            }
          },
          "400": {
            "description": "Parámetros, cuerpo o cursor inválidos (INVALID_ARGUMENT).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Bearer ausente o inválido, o sesión rechazada por IAM (UNAUTHENTICATED).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Base de datos o IAM no disponibles (SERVICE_UNAVAILABLE).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Garments"
        ],
        "summary": "Registrar una prenda",
        "operationId": "createGarment",
        "description": "El propietario sale del token validado con IAM, nunca del cuerpo.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GarmentInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Prenda creada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Garment"
                }
              }
            }
          },
          "400": {
            "description": "Parámetros, cuerpo o cursor inválidos (INVALID_ARGUMENT).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Bearer ausente o inválido, o sesión rechazada por IAM (UNAUTHENTICATED).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Base de datos o IAM no disponibles (SERVICE_UNAVAILABLE).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/garments/resolve": {
      "post": {
        "tags": [
          "Garments"
        ],
        "summary": "Resolver prendas por IDs",
        "operationId": "resolveGarments",
        "description": "Contrato con Recommendation (§6). Entre 1 y 100 UUID únicos. Una prenda ajena se ve como NOT_FOUND.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResolveRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Un resultado por ID, en el orden pedido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResolveResult"
                }
              }
            }
          },
          "400": {
            "description": "Parámetros, cuerpo o cursor inválidos (INVALID_ARGUMENT).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Bearer ausente o inválido, o sesión rechazada por IAM (UNAUTHENTICATED).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Base de datos o IAM no disponibles (SERVICE_UNAVAILABLE).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
