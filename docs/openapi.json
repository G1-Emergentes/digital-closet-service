        }
      },
      "delete": {
        "tags": [
          "Outfits"
        ],
        "summary": "Eliminar un outfit (borrado lógico)",
        "operationId": "deleteOutfit",
        "parameters": [
          {
            "$ref": "#/components/parameters/OutfitId"
          }
        ],
        "responses": {
          "204": {
            "description": "Outfit eliminado. Sus prendas siguen en el armario."
          },
          "400": {
            "description": "Parámetros, cuerpo o cursor inválidos (INVALID_ARGUMENT).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Bearer ausente o inválido, o sesión rechazada por IAM (UNAUTHENTICATED).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Outfit inexistente, eliminado o ajeno (OUTFIT_NOT_FOUND). No se distingue cuál.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Base de datos o IAM no disponibles (SERVICE_UNAVAILABLE).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/outfits/{id}/image-upload": {
      "post": {
        "tags": [
          "Outfits"
        ],
        "summary": "Pedir una URL firmada para subir el look",
        "operationId": "createOutfitImageUpload",
        "description": "Sube el archivo con PUT a upload_url y luego regístralo con PUT /outfits/{id}/image.",
        "parameters": [
          {
            "$ref": "#/components/parameters/OutfitId"
          }
        ],
        "responses": {
          "200": {
            "description": "image_id nuevo y URL de subida (PUT directo a Storage).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImageUpload"
                }
              }
            }
          },
          "400": {
            "description": "Parámetros, cuerpo o cursor inválidos (INVALID_ARGUMENT).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Bearer ausente o inválido, o sesión rechazada por IAM (UNAUTHENTICATED).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Outfit inexistente, eliminado o ajeno (OUTFIT_NOT_FOUND). No se distingue cuál.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Base de datos o IAM no disponibles (SERVICE_UNAVAILABLE).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/outfits/{id}/image": {
      "put": {
        "tags": [
          "Outfits"
        ],
        "summary": "Registrar el look ya subido",
        "operationId": "setOutfitImage",
        "parameters": [
          {
            "$ref": "#/components/parameters/OutfitId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ImageRegistration"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Outfit con la imagen registrada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Outfit"
                }
              }
            }
          },
          "400": {
            "description": "Parámetros, cuerpo o cursor inválidos (INVALID_ARGUMENT).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Bearer ausente o inválido, o sesión rechazada por IAM (UNAUTHENTICATED).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Outfit inexistente, eliminado o ajeno (OUTFIT_NOT_FOUND). No se distingue cuál.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Base de datos o IAM no disponibles (SERVICE_UNAVAILABLE).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/outfits/{id}/image-access": {
      "get": {
        "tags": [
          "Outfits"
        ],
        "summary": "Obtener una URL temporal del look",
        "operationId": "getOutfitImageAccess",
        "parameters": [
          {
            "$ref": "#/components/parameters/OutfitId"
          }
        ],
        "responses": {
          "200": {
            "description": "URL HTTPS firmada de 5 minutos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImageAccess"
                }
              }
            }
          },
          "400": {
            "description": "Parámetros, cuerpo o cursor inválidos (INVALID_ARGUMENT).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Bearer ausente o inválido, o sesión rechazada por IAM (UNAUTHENTICATED).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Outfit inexistente o ajeno (OUTFIT_NOT_FOUND), o outfit sin look (IMAGE_NOT_FOUND).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Base de datos o IAM no disponibles (SERVICE_UNAVAILABLE).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Access token de IAM. Introducir solo el token; Swagger agrega Bearer."
      }
    },
    "parameters": {
      "GarmentId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "OutfitId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 50
        }
      },
      "Cursor": {
        "name": "cursor",
        "in": "query",
        "description": "Opaco, emitido por el servidor.",
        "schema": {
          "type": "string"
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "example": "GARMENT_NOT_FOUND",
                "enum": [
                  "INVALID_ARGUMENT",
                  "UNAUTHENTICATED",
                  "GARMENT_NOT_FOUND",
                  "OUTFIT_NOT_FOUND",
                  "IMAGE_NOT_FOUND",
                  "INTERNAL_ERROR",
                  "SERVICE_UNAVAILABLE"
                ]
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "GarmentInput": {
        "type": "object",
        "required": [
          "name",
          "category",
          "colors",
          "styles",
          "description"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "example": "Mi casaca denim"
          },
          "category": {
            "type": "string",
            "enum": [
              "TOP",
              "BOTTOM",
              "ONE_PIECE",
              "OUTERWEAR",
              "FOOTWEAR",
              "ACCESSORY"
            ]
          },
          "subcategory": {
            "type": "string",
            "pattern": "^[A-Z0-9_]{1,60}$",
            "example": "DENIM_JACKET",
            "nullable": true
          },
          "colors": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "BLACK",
                "WHITE",
                "GRAY",
                "BLUE",
                "RED",
                "GREEN",
                "YELLOW",
                "ORANGE",
                "PURPLE",
                "PINK",
                "BROWN",
                "BEIGE",
                "MULTICOLOR"
              ]
            },
            "description": "El primero es el color principal; puede ser []."
          },
          "styles": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "CASUAL",
                "FORMAL",
                "SPORT",
                "STREETWEAR",
                "MINIMALIST",
                "CLASSIC",
                "BOHEMIAN"
              ]
            }
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "example": "Casaca azul denim, manga larga, sin estampado."
          },
          "availability": {
            "type": "string",
            "enum": [
              "AVAILABLE",
              "UNAVAILABLE"
            ],
            "description": "Opcional al crear (AVAILABLE); obligatorio al editar."
          }
        }
      },
      "Garment": {
        "type": "object",
        "required": [
          "id",
          "name",
          "category",
          "subcategory",
          "colors",
          "styles",
          "description",
          "availability",
          "image",
          "revision",
          "updated_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "TOP",
              "BOTTOM",
              "ONE_PIECE",
              "OUTERWEAR",
              "FOOTWEAR",
              "ACCESSORY"
            ]
          },
          "subcategory": {
            "type": "string",
            "nullable": true
          },
          "colors": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "BLACK",
                "WHITE",
                "GRAY",
                "BLUE",
                "RED",
                "GREEN",
                "YELLOW",
                "ORANGE",
                "PURPLE",
                "PINK",
                "BROWN",
                "BEIGE",
                "MULTICOLOR"
              ]
            }
          },
          "styles": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "CASUAL",
                "FORMAL",
                "SPORT",
                "STREETWEAR",
                "MINIMALIST",
                "CLASSIC",
                "BOHEMIAN"
              ]
            }
          },
          "description": {
            "type": "string"
          },
          "availability": {
            "type": "string",
            "enum": [
              "AVAILABLE",
              "UNAVAILABLE"
            ]
          },
          "image": {
            "type": "object",
            "nullable": true,
            "required": [
              "id",
              "version"
            ],
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "version": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "GarmentPage": {
        "type": "object",
        "required": [
          "items",
          "next_cursor"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Garment"
            }
          },
          "next_cursor": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "ResolveRequest": {
        "type": "object",
        "required": [
          "ids"
        ],
        "properties": {
          "ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      },
      "ResolveResult": {
        "type": "object",
        "required": [
          "results"
        ],
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "status",
                "garment"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "AVAILABLE",
                    "UNAVAILABLE",
                    "NOT_FOUND"
                  ]
                },
                "garment": {
                  "nullable": true,
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Garment"
                    }
                  ],
                  "description": "Solo con AVAILABLE."
                }
              }
            }
          }
        }
      },
      "ImageUpload": {
        "type": "object",
        "required": [
          "image_id",
          "upload_url",
          "method"
        ],
        "properties": {
          "image_id": {
            "type": "string",
            "format": "uuid"
          },
          "upload_url": {
            "type": "string",
            "format": "uri"
          },
          "method": {
            "type": "string",
            "enum": [
              "PUT"
            ]
          }
        }
      },
      "ImageRegistration": {
        "type": "object",
        "required": [
          "image_id"
        ],
        "properties": {
          "image_id": {
            "type": "string",
            "format": "uuid",
            "description": "El image_id devuelto por image-upload."
          }
        }
      },
      "ImageAccess": {
        "type": "object",
        "required": [
          "image_id",
          "image_version",
          "url",
          "expires_at",
          "mime_type"
        ],
        "properties": {
          "image_id": {
            "type": "string",
            "format": "uuid"
          },
          "image_version": {
            "type": "integer"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "mime_type": {
            "type": "string",
            "example": "image/jpeg"
          }
        }
      },
      "OutfitInput": {
        "type": "object",
        "required": [
          "garment_ids"
        ],
        "properties": {
          "garment_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "example": "Oficina",
            "nullable": true
          },
          "occasion": {
            "type": "string",
            "maxLength": 50,
            "example": "Trabajo",
            "nullable": true
          },
          "style": {
            "type": "string",
            "maxLength": 50,
            "example": "CASUAL",
            "nullable": true
          },
          "recommendation_id": {
            "type": "string",
            "format": "uuid",
            "nullable": true,
            "description": "Solo al crear: id de la propuesta de Recommendation de la que viene."
          }
        }
      },
      "Outfit": {
        "type": "object",
        "required": [
          "id",
          "name",
          "occasion",
          "style",
          "source",
          "recommendation_id",
          "garment_ids",
          "complete",
          "image",
          "created_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "occasion": {
            "type": "string",
            "nullable": true
          },
          "style": {
            "type": "string",
            "nullable": true
          },
          "source": {
            "type": "string",
            "enum": [
              "MANUAL",
              "RECOMMENDATION"
            ]
          },
          "recommendation_id": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "garment_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "description": "En orden de posición."
          },
          "complete": {
            "type": "boolean",
            "description": "false si se eliminó alguna prenda del outfit."
          },
          "image": {
            "type": "object",
            "nullable": true,
            "required": [
              "id",
              "version"
            ],
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "version": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "OutfitPage": {
        "type": "object",
        "required": [
          "items",
          "next_cursor"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Outfit"
            }
          },
          "next_cursor": {
            "type": "string",
            "nullable": true
          }
        }
      }
    }
  }
}
