# This service's own Supabase project (Wardrobe database). The secret key stays on the server.
SUPABASE_URL=https://your-wardrobe-project.supabase.co
SUPABASE_SECRET_KEY=your-secret-key

# IAM's Supabase project, used only to validate bearer tokens (same values as iam-service/.env).
IAM_SUPABASE_URL=https://your-iam-project.supabase.co
IAM_SUPABASE_PUBLISHABLE_KEY=your-iam-publishable-key

# Visualization worker: Cloudflare Workers AI (token needs Workers AI Read+Edit).
CF_ACCOUNT_ID=your-cloudflare-account-id
CF_API_TOKEN=your-cloudflare-api-token
